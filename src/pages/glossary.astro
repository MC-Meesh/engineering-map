---
// Plain-language glossary of the terms the site uses (data/plain.yaml).
import Base from '../layouts/Base.astro';
import { glossary } from '../lib/data';
---
<Base title="Glossary" section="about" description="Plain-language definitions of the engineering software terms used on the map.">
  <article class="page">
    <header class="page-head">
      <h1>Glossary</h1>
      <p class="lede">The words this site uses, in plain language. Dotted links elsewhere on the site lead here.</p>
    </header>
    <dl class="spec glossary">
      {glossary.map((g) => <><dt id={g.id}>{g.term}</dt><dd>{g.plain}</dd></>)}
    </dl>
  </article>
</Base>

<style>
  .glossary dt { font-weight: 600; color: var(--ink); font-size: var(--fs-1); scroll-margin-top: calc(var(--header-h) + 1rem); }
  .glossary dt:target, .glossary dt:target + dd { background: var(--red-wash); }
</style>
