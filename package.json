{
  "name": "engineering-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "node scripts/build-graph.mjs && node scripts/vendor-assets.mjs",
    "examples": "python3 scripts/gen_examples.py",
    "dev": "npm run data && astro dev --host 0.0.0.0 --port 3480",
    "build": "npm run data && astro build",
    "preview": "astro preview --host 0.0.0.0 --port 3480",
    "check-links": "node scripts/check-links.mjs",
    "shots": "node scripts/ux-shots.mjs",
    "e2e": "node scripts/e2e-lens-focus.mjs",
    "stale": "node scripts/stale.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@sigma/node-border": "^3.0.0",
    "astro": "^5.7.0",
    "graphology": "^0.26.0",
    "occt-import-js": "^0.0.23",
    "sigma": "^3.0.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "d3-hierarchy": "^3.1.3",
    "graphology-layout-forceatlas2": "^0.10.1",
    "js-yaml": "^4.1.0",
    "playwright-core": "^1.52.0"
  },
  "license": "CC-BY-SA-4.0",
  "description": "A sourced, navigable map of the engineering software landscape: tools, kernels, vendors, formats and acquisitions.",
  "repository": {
    "type": "git",
    "url": "https://github.com/MC-Meesh/engineering-map.git"
  }
}
